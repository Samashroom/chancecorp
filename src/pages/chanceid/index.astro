---
// src/pages/canvas-export.astro
---

<meta charset="UTF-8" />
<!-- Use stable Cropper.js v1.5.13 -->
<link
  href="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.css"
  rel="stylesheet"
/>
<script src="https://cdn.jsdelivr.net/npm/cropperjs@1.5.13/dist/cropper.min.js"
></script>
<!-- Arial Narrow web font for Android and other systems -->
<link rel="stylesheet" href="https://fonts.cdnfonts.com/css/arial-narrow" />
<!-- jsPDF for PDF export -->
<script
  src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"
></script>

<div class="editor">
  <!-- УПРАВЛЕНИЕ ФОТО -->
  <div class="photo-controls">
    <input type="file" id="photoInput" accept="image/*" />
    <div class="text-controls">
      <p>
        Первое имя:
        <input type="text" id="line1Input" placeholder="Имя" />
      </p>
      <p>
        Второе имя/отчество/родовое имя (количество ограничено):
        <input type="text" id="line2Input" placeholder="Второе имя" />
      </p>
      <p>
        Фамилия:
        <input type="text" id="line3Input" placeholder="Фамилия" />
      </p>
      <p>
        Гендер:
        <select id="choice1Input">
          <option value=""></option>
          <option value="М">Мужской</option>
          <option value="Ж">Женский</option>
          <option value="Х">Другой</option>
        </select>
      </p>

      <p>
        Дата регистрации:
        <input
          type="text"
          id="date1Input"
          placeholder="__.__.____"
          maxlength="10"
          inputmode="text"
          autocomplete="off"
        />
      </p>
      <p>
        Дата выдачи:
        <input
          type="text"
          id="date2Input"
          placeholder="__.__.____"
          maxlength="10"
          inputmode="text"
          autocomplete="off"
        />
      </p>
      <p class="section-title">Место регистрации</p>
      <p>
        <label for="placeRegLevel1">Место</label>
        <select id="placeRegLevel1">
          <option value=""></option>
          <option value="Полис">Полис</option>
          <option value="Сити">Сити</option>
          <option value="Башня">Башня</option>
        </select>
      </p>
      <p class="nested-field hidden" id="placeRegLevel2Row">
        <label for="placeRegLevel2">Район</label>
        <select id="placeRegLevel2">
          <option value=""></option>
          <option value="Район 1">Район 1</option>
          <option value="Район 2">Район 2</option>
          <option value="own">Свой вариант</option>
        </select>
        <input id="placeRegLevel2Custom" class="custom-input hidden" type="text" placeholder="Свой вариант" />
      </p>
      <p class="nested-field hidden" id="placeRegLevel3Row">
        <label for="placeRegLevel3">Уточнение</label>
        <select id="placeRegLevel3">
          <option value=""></option>
          <option value="Уточнение 1">Уточнение 1</option>
          <option value="Уточнение 2">Уточнение 2</option>
          <option value="own">Свой вариант</option>
        </select>
        <input id="placeRegLevel3Custom" class="custom-input hidden" type="text" placeholder="Свой вариант" />
      </p>
      <p class="section-title">Место выдачи</p>
      <p>
        <label for="placeIssueLevel1">Тип</label>
        <select id="placeIssueLevel1">
          <option value=""></option>
          <option value="Полис">Полис</option>
          <option value="Сити">Сити</option>
        </select>
      </p>
      <p class="nested-field hidden" id="placeIssueLevel2Row">
        <label for="placeIssueLevel2">Район</label>
        <select id="placeIssueLevel2">
          <option value=""></option>
          <option value="Район 1">Район 1</option>
          <option value="Район 2">Район 2</option>
          <option value="own">Свой вариант</option>
        </select>
        <input id="placeIssueLevel2Custom" class="custom-input hidden" type="text" placeholder="Свой вариант" />
      </p>
      <p class="nested-field hidden" id="placeIssueLevel3Row">
        <label for="placeIssueLevel3">Уточнение</label>
        <select id="placeIssueLevel3">
          <option value=""></option>
          <option value="Уточнение 1">Уточнение 1</option>
          <option value="Уточнение 2">Уточнение 2</option>
          <option value="own">Свой вариант</option>
        </select>
        <input id="placeIssueLevel3Custom" class="custom-input hidden" type="text" placeholder="Свой вариант" />
      </p>
    </div>
    <div id="cropperContainer" class="cropper-container" style="display: none;">
      <img id="cropperImage" src="" />
      <div class="cropper-buttons">
        <button id="applyCropBtn">✓ Применить</button>
        <button id="cancelCropBtn">✕ Отмена</button>
      </div>
    </div>
  </div>

  <!-- CANVAS КАРТОЧКА -->
  <canvas id="cardCanvas"></canvas>

  <!-- КНОПКИ СКАЧИВАНИЯ -->
  <div class="download-controls">
    <button id="downloadPngBtn">📥 Скачать PNG</button>
    <button id="downloadJpgBtn">📥 Скачать JPG</button>
    <button id="downloadPdfBtn">📥 Скачать PDF</button>
  </div>
</div>

<script type="module">
  import { createChanceIdApp } from "/js/chanceid.js";

  const placeRegLevel1 = document.getElementById("placeRegLevel1");
  const placeRegLevel2 = document.getElementById("placeRegLevel2");
  const placeRegLevel2Custom = document.getElementById("placeRegLevel2Custom");
  const placeRegLevel3 = document.getElementById("placeRegLevel3");
  const placeRegLevel3Custom = document.getElementById("placeRegLevel3Custom");
  const placeRegLevel2Row = document.getElementById("placeRegLevel2Row");
  const placeRegLevel3Row = document.getElementById("placeRegLevel3Row");
  const placeIssueLevel1 = document.getElementById("placeIssueLevel1");
  const placeIssueLevel2 = document.getElementById("placeIssueLevel2");
  const placeIssueLevel2Custom = document.getElementById("placeIssueLevel2Custom");
  const placeIssueLevel3 = document.getElementById("placeIssueLevel3");
  const placeIssueLevel3Custom = document.getElementById("placeIssueLevel3Custom");
  const placeIssueLevel2Row = document.getElementById("placeIssueLevel2Row");
  const placeIssueLevel3Row = document.getElementById("placeIssueLevel3Row");
  const choice1Input = document.getElementById("choice1Input");

  const placeFieldSets = [
    {
      level1: placeRegLevel1,
      level2: placeRegLevel2,
      level3: placeRegLevel3,
      level2Row: placeRegLevel2Row,
      level3Row: placeRegLevel3Row,
      level2Custom: placeRegLevel2Custom,
      level3Custom: placeRegLevel3Custom,
    },
    {
      level1: placeIssueLevel1,
      level2: placeIssueLevel2,
      level3: placeIssueLevel3,
      level2Row: placeIssueLevel2Row,
      level3Row: placeIssueLevel3Row,
      level2Custom: placeIssueLevel2Custom,
      level3Custom: placeIssueLevel3Custom,
    },
  ];

  function updatePlaceFields(fieldSet) {
    const { level1, level2, level3, level2Row, level3Row, level2Custom, level3Custom } = fieldSet;

    if (level1 && level1.value === "Полис") {
      level2Row.classList.remove("hidden");
    } else {
      level2Row.classList.add("hidden");
      if (level2) level2.value = "";
      if (level2Custom) {
        level2Custom.classList.add("hidden");
        level2Custom.value = "";
      }
      level3Row.classList.add("hidden");
      if (level3) level3.value = "";
      if (level3Custom) {
        level3Custom.classList.add("hidden");
        level3Custom.value = "";
      }
      return;
    }

    if (level2 && level2.value === "own") {
      level2Custom.classList.remove("hidden");
    } else {
      level2Custom.classList.add("hidden");
      if (level2Custom) level2Custom.value = "";
    }

    if (level2 && level2.value) {
      level3Row.classList.remove("hidden");
    } else {
      level3Row.classList.add("hidden");
      if (level3) level3.value = "";
      if (level3Custom) {
        level3Custom.classList.add("hidden");
        level3Custom.value = "";
      }
    }

    if (level3 && level3.value === "own") {
      level3Custom.classList.remove("hidden");
    } else {
      if (level3Custom) {
        level3Custom.classList.add("hidden");
        if (level3Custom.value === "") {
          level3Custom.value = "";
        }
      }
    }
  }

  function getPlaceValue(level1, level2, level2Custom, level3, level3Custom) {
    let result = level1 && level1.value ? level1.value : "";

    if (level1 && level1.value === "Полис" && level2 && level2.value) {
      const second = level2.value === "own" ? level2Custom.value : level2.value;
      if (second) {
        result += result ? ` / ${second}` : second;
      }
    }

    if (level3 && level3.value) {
      const third = level3.value === "own" ? level3Custom.value : level3.value;
      if (third) {
        result += result ? ` / ${third}` : third;
      }
    }

    return result;
  }

  function refreshPlaceFields() {
    placeFieldSets.forEach((set) => updatePlaceFields(set));
    if (app && typeof app.drawCard === "function") {
      app.drawCard();
    }
  }

  placeFieldSets.forEach((set) => {
    if (set.level1) set.level1.addEventListener("change", refreshPlaceFields);
    if (set.level2) set.level2.addEventListener("change", refreshPlaceFields);
    if (set.level3) set.level3.addEventListener("change", refreshPlaceFields);
  });

  const app = createChanceIdApp({
    canvasId: "cardCanvas",
    photoInputId: "photoInput",
    cropperContainerId: "cropperContainer",
    cropperImageId: "cropperImage",
    applyCropBtnId: "applyCropBtn",
    cancelCropBtnId: "cancelCropBtn",
    downloadPngBtnId: "downloadPngBtn",
    downloadJpgBtnId: "downloadJpgBtn",
    downloadPdfBtnId: "downloadPdfBtn",
    lineInputIds: ["line1Input", "line2Input", "line3Input"],
    choiceInputId: "choice1Input",
    dateInputIds: ["date1Input", "date2Input"],
    placeValueGetter: () => ({
      t1: getPlaceValue(
        placeRegLevel1,
        placeRegLevel2,
        placeRegLevel2Custom,
        placeRegLevel3,
        placeRegLevel3Custom,
      ),
      t2: getPlaceValue(
        placeIssueLevel1,
        placeIssueLevel2,
        placeIssueLevel2Custom,
        placeIssueLevel3,
        placeIssueLevel3Custom,
      ),
    }),
  });

  if (choice1Input) {
    choice1Input.addEventListener("change", () => app.drawCard());
  }

  refreshPlaceFields();
  app.drawCard();
</script>

<style>
  .editor {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 20px;
  }

  canvas {
    display: block;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    border: 1px solid #ddd;
  }

  /* ===== УПРАВЛЕНИЕ ФОТО ===== */
  .photo-controls {
    display: flex;
    flex-direction: column;
    gap: 15px;
    background: #f5f5f5;
    padding: 20px;
    border-radius: 8px;
  }

  .text-controls {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: stretch;
  }

  .text-controls p {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    margin: 0;
    padding: 10px 12px;
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
    background: #ffffff;
  }

  .text-controls p label {
    font-weight: 600;
    color: #2f3740;
  }

  .text-controls input,
  .text-controls select {
    padding: 8px 10px;
    border: 1px solid #ccc;
    border-radius: 4px;
    font-size: 14px;
    font-family: "Arial Narrow", Arial, sans-serif;
    width: 100%;
    box-sizing: border-box;
  }

  .place-grid {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 10px;
  }

  .place-column {
    display: contents;
  }

  .section-title {
    font-size: 16px;
    font-weight: 700;
    color: #1f4265;
    margin: 20px 0 6px;
  }

  .nested-field {
    background: #eef5fb;
    border-color: #b7d9f2;
    padding-left: 16px;
  }

  .nested-field label {
    min-width: 120px;
  }

  .custom-input {
    flex: 1 1 220px;
  }

  .hidden {
    display: none !important;
  }

  #photoInput {
    padding: 10px;
    border: 2px solid #1d1dca;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
    font-family: "Arial Narrow", Arial, sans-serif;
  }

  #photoInput::file-selector-button {
    background: #2442c7;
    color: white;
    padding: 8px 16px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: bold;
    margin-right: 10px;
  }

  #photoInput::file-selector-button:hover {
    background: #1d1dca;
  }

  /* ===== CROPPER КОНТЕЙНЕР ===== */
  .cropper-container {
    background: white;
    border: 2px solid #2c7a88;
    border-radius: 8px;
    padding: 15px;
    max-width: 600px;
  }

  #cropperImage {
    max-width: 100%;
    max-height: 400px;
  }

  .cropper-buttons {
    display: flex;
    gap: 10px;
    margin-top: 15px;
    justify-content: center;
  }

  button {
    padding: 10px 20px;
    font-size: 16px;
    background: #4caf50;
    color: white;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-weight: bold;
    transition: background 0.3s;
  }

  button:hover {
    background: #45a049;
  }

  #cancelCropBtn {
    background: #f44336;
  }

  #cancelCropBtn:hover {
    background: #da190b;
  }

  input,
  select {
    margin: 10px;
    padding: 8px;
  }

  /* ===== DOWNLOAD CONTROLS ===== */
  .download-controls {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .download-controls button {
    background: #2196f3;
    padding: 12px 20px;
    font-size: 16px;
    border-radius: 6px;
    font-family: "Arial Narrow", Arial, sans-serif;
  }

  .download-controls button:hover {
    background: #0b7dda;
  }

  @media (max-width: 900px) {
    .editor {
      padding: 16px;
    }

    canvas {
      width: 100%;
      height: auto;
      max-width: 100%;
    }

    .photo-controls {
      padding: 16px;
    }

    .text-controls {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .text-controls input,
    .text-controls select {
      width: 100%;
    }

    .download-controls {
      flex-direction: column;
      align-items: stretch;
    }

    .download-controls button {
      width: 100%;
      padding: 14px;
    }
  }

  @media (max-width: 640px) {
    .editor {
      gap: 16px;
      padding: 12px;
    }

    .photo-controls {
      gap: 12px;
    }

    .text-controls {
      gap: 8px;
    }

    .download-controls {
      gap: 8px;
    }

    button {
      font-size: 14px;
      padding: 12px 16px;
    }
  }
</style>
