---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("news");

  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, "") },
  }));
}

const rawSlug = Astro.params.slug;
const slug = Array.isArray(rawSlug) ? rawSlug.join("/") : rawSlug;
if (!slug) return Astro.redirect("/404");

const posts = await getCollection("news");
const entry = posts.find((post) => post.id.replace(/\.md$/, "") === slug);
if (!entry) return Astro.redirect("/404");

const { Content } = await render(entry);
const infobox = entry.data.infobox;

import BaseNews from "../../layouts/news/BaseNews.astro";
---

<html>
  <BaseNews>
    
    <div class="max-w-4xl mx-auto p-4">
      
      <!-- Инфобокс: плавает справа, текст будет его обтекать -->
      {infobox && (
        <aside class="float-left w-64 mr-4 mb-4 border border-gray-300 rounded-lg overflow-hidden bg-gray-50 text-sm clearfix">
          <div class="bg-gray-200 px-3 py-2 font-bold text-center border-b border-gray-300">
            {entry.data.title}
          </div>
          <table class="w-full">
            <tbody>
              {Object.entries(infobox).map(([key, value]) => (
                <tr class="border-b border-gray-200 last:border-b-0">
                  <th class="text-left px-3 py-1.5 font-semibold text-gray-700 w-1/3 align-top">{key}</th>
                  <td class="px-3 py-1.5 text-gray-900">{value}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </aside>
      )}
      <div class="prose prose-lg max-w-none ...">
        <Content />
      </div>
    </div>
  </BaseNews>
</html>
